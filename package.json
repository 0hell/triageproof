{
  "name": "triageproof",
  "version": "0.2.0",
  "description": "Evidence-first issue preflight for open-source maintainers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0hell/triageproof.git"
  },
  "homepage": "https://github.com/0hell/triageproof#readme",
  "bugs": {
    "url": "https://github.com/0hell/triageproof/issues"
  },
  "type": "module",
  "bin": {
    "triageproof": "./bin/triageproof.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "scripts",
    "*.md",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "demo": "node scripts/demo.js",
    "test": "node --test test/analyzer.test.js test/cli.test.js test/security.test.js test/action.test.js",
    "check": "node --check bin/triageproof.js && node --check src/action.js && npm test"
  },
  "keywords": [
    "github-issues",
    "issue-triage",
    "maintainer-tools",
    "open-source",
    "security"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
